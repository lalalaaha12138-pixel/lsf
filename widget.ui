    border-color: #383838;
}

QSlider::groove:horizontal {
    height: 3px;
    background-color: #5c5c5c;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background-color: #479ef5;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background-color: #ffffff;
    border: 1px solid #479ef5;
    border-radius: 6px;
}

