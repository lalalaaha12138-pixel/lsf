    border-radius: 21px;
    font-size: 17px;
}

QPushButton#playPauseButton:hover {
    background-color: #62abf5;
    border-color: #62abf5;
}

QPushButton#rewindButton,
QPushButton#forwardButton,
QPushButton#stopButton {
    min-width: 46px;
