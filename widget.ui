}

QPushButton {
    min-height: 32px;
    padding: 0 12px;
    color: #ffffff;
    background-color: #333333;
    border: 1px solid #454545;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #3d3d3d;
    border-color: #505050;
}

QPushButton:pressed {
    color: #c7c7c7;
    background-color: #292929;
    border-color: #393939;
}

QPushButton#openButton {
